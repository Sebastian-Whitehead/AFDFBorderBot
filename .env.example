# Discord Bot Token - Get this from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID - Your bot's application ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# Database Configuration (Optional - only if you use database features)
DATABASE_URL=postgres://postgres:admin@postgres:5432/AFdb

# Shared Supabase DB: use the SESSION pooler string (port 5432), add ?ssl=require
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?ssl=require

# Optional: Steam Web API key, used to resolve custom steamcommunity.com/id/<name> links.
# Without it the bot falls back to the keyless profile XML (stricter rate limits).
# STEAM_API_KEY=
