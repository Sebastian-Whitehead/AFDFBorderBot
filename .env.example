# Discord Bot Token - Get this from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID - Your bot's application ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# Database Configuration (Optional - only if you use database features)
DATABASE_URL=postgres://postgres:admin@postgres:5432/AFdb

# Music Player Configuration
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Spotify API Configuration (Required for Spotify support)
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
